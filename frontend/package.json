{
  "name": "retirement-sim-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts vite.config.ts eslint.config.js",
    "lint:fix": "eslint src scripts vite.config.ts eslint.config.js --fix",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "perf:report": "node scripts/check-bundle-size.mjs",
    "perf:gate:warn": "node scripts/check-bundle-size.mjs --warn",
    "perf:gate:hard": "node scripts/check-bundle-size.mjs --enforce",
    "perf:gate": "node scripts/check-bundle-size.mjs --enforce",
    "verify:refactor": "npm run lint && npm run check:duplicates && npm run typecheck && npm run check:imports && npm run perf:report",
    "verify:pr": "npm run lint && npm run check:duplicates && npm run typecheck && npm run check:imports && npm run test -- --run && npm run build && npm run perf:gate:warn",
    "verify:ci": "npm run lint && npm run check:duplicates && npm run typecheck && npm run check:imports && npm run test -- --run && npm run build && npm run perf:gate:hard"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
